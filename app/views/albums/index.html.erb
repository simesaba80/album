<div class="page-header">
  <h1 class="page-title">Albums</h1>
  <%= link_to "New Album", new_album_path, class: "btn btn-primary" %>
</div>

<% if @albums.any? %>
  <div id="albums" class="albums-grid">
    <% @albums.each do |album| %>
      <%= link_to album_path(album), class: "album-link" do %>
        <article class="album-card">
          <% if album.cover_image.attached? %>
            <%= image_tag album.cover_image, class: "album-cover" %>
          <% else %>
            <div class="album-empty-cover">
              No cover image
            </div>
          <% end %>

          <div class="album-card-body">
            <p class="album-title"><%= album.title.presence || "Untitled Album" %></p>
            <p class="album-meta">
              <%= album.status.humanize %>
            </p>
          </div>
        </article>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="empty-message">No albums yet. Create your first album.</p>
<% end %>