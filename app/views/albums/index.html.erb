<h1>Albums#index</h1>
<p>Find me in app/views/albums/index.html.erb</p>
<%= link_to "New Album", new_album_path %>

<div id="albums">
    <% @albums.each do |album| %>
        <div class="album">
            <%= link_to album_path(album) do %>
                <% if album.cover_image.attached? %>
                    <%= image_tag album.cover_image, class: "album-cover" %>
                <% end %>
                <%= album.title %>
            <% end %>
        </div>
    <% end %>
</div>