<h1>New Album</h1>

<%= form_with model: @album do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>
  <div>
    <%= form.label :cover_image, style: "display: block" %>
    <%= form.file_field :cover_image, accept: "image/*" %>
  </div>
  <div>
    <%= form.label :photo_images, "Photos", style: "display: block" %>
    <div data-controller="photo-inputs">
      <div data-photo-inputs-target="list" style="display: grid; gap: 8px;"></div>
      <template data-photo-inputs-target="template">
        <div data-photo-inputs-row style="display: flex; gap: 8px; align-items: center;">
          <input
            type="file"
            name="album[photo_images][]"
            accept="image/*"
            data-action="change->photo-inputs#onFileChange"
          >
          <button type="button" data-action="photo-inputs#removeRow">Remove</button>
        </div>
      </template>
    </div>
  </div>
  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>
  <div>
    <%= form.label :status %>
    <%= form.select :status, Album.statuses.keys.map { |status| [status.humanize, status] } %>
  </div>
  <div>
    <%= form.submit "Create Album" %>
  </div>
<% end %>

<%= link_to "Back to Albums", albums_path %>