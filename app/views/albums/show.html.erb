<h1><%= @album.title %></h1>

<div style="display: flex; gap: 12px; flex-wrap: wrap;">
  <% @album.photos.each do |photo| %>
    <% next unless photo.image.attached? %>

    <%= image_tag photo.image, style: "width: 200px; height: 200px; object-fit: cover;" %>
  <% end %>
</div>

<%= link_to "Back to Albums", albums_path %>
