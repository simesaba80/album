<h1><%= @album.title %></h1>

<div class="photos-grid">
  <% @album.photos.each do |photo| %>
    <% next unless photo.image.attached? %>

    <%= image_tag photo.image, class: "photo-thumb" %>
  <% end %>
</div>

<div class="back-link">
  <%= link_to "Back to Albums", albums_path, class: "btn" %>
</div>
